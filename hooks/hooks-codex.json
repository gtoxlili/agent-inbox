{
  "description": "Per-session message queue: processes running in a session post messages that reach the agent before its next model call",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${PLUGIN_ROOT}\"/bin/agent-inbox session-start", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}\"/bin/agent-inbox drain", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}\"/bin/agent-inbox drain", "timeout": 10 }] }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"${PLUGIN_ROOT}\"/bin/agent-inbox session-end", "timeout": 3 }
        ]
      }
    ]
  }
}
